# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# MySQL connection (used for both app queries and session store)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=user_management

# Google OAuth (optional; both credentials are required to enable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
